<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Executable version 1.4.0; MCP serverInfo.version belongs to the DataGateway library. -->
    <Version>1.4.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>DataGateway-Web</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.14" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <ProjectReference Include="../DataGateway/DataGateway.csproj" />
    <ProjectReference Include="../DataGateway.Core/DataGateway.Core.csproj" />
    <ProjectReference Include="../DataGateway.Data/DataGateway.Data.csproj" />
    <ProjectReference Include="../DataGateway.Data.SqlServer/DataGateway.Data.SqlServer.csproj" />
    <ProjectReference Include="../DataGateway.Data.PostgreSql/DataGateway.Data.PostgreSql.csproj" />
  </ItemGroup>
</Project>
