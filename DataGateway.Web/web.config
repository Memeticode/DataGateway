<?xml version="1.0" encoding="utf-8"?>
<!-- IIS settings for DataGateway.Web (IIS.md). IIS does the Windows sign-in handshake and hands the signed-in user
     to the app, whose Negotiate handler then defers to IIS; anonymous callers never reach the app.
     dotnet publish copies this file as it is; IIS starts the published DataGateway.Web.dll with the dotnet that the
     ASP.NET Core Hosting Bundle installs. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\DataGateway.Web.dll" stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <!-- These two sections are locked at server level by default: IIS.md, step 3, unlocks them. -->
        <authentication>
          <anonymousAuthentication enabled="false" />
          <windowsAuthentication enabled="true" />
        </authentication>
      </security>
      <!-- MCP answers can stream; dynamic compression would hold them until the end. -->
      <urlCompression doDynamicCompression="false" />
    </system.webServer>
  </location>
</configuration>
